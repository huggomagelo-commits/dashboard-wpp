# Copie para .env (local) e configure as mesmas variáveis no Netlify.
# Sem elas o painel roda em modo demonstração, com dados no navegador.
#
# Supabase → Project Settings → Data API
#   Project URL  -> VITE_SUPABASE_URL
#   anon public  -> VITE_SUPABASE_ANON_KEY
#
# A chave `anon` é pública por natureza: ela vai no JavaScript do navegador e
# não dá acesso a nada sozinha — quem protege os dados é a RLS do schema.sql.
#
# NUNCA coloque aqui a chave `service_role`. Ela ignora a RLS e só pode viver
# no backend (o bridge do WhatsApp, na Fase 3).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
